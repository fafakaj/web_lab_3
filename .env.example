# Пример настроек. Скопируйте файл в .env и при желании поменяйте значения.
# Файл .env не попадает в git: в нём пароли и секрет JWT.
# .env читает сервер Open Liberty: плагин Maven копирует его в настройки сервера.

# Порт, на котором открывается приложение: http://localhost:8080/
HTTP_PORT=8080

# База данных PostgreSQL: создайте базу и пользователя с этими именем, логином и паролем
DB_HOST=localhost
DB_PORT=5432
DB_NAME=students
DB_USER=students
DB_PASSWORD=students

# Секрет для подписи JWT — случайная строка не короче 32 символов.
# Кто знает секрет, может выпустить любой токен, поэтому в настоящем проекте его держат в тайне
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
# Время жизни токенов: access — в минутах, refresh — в днях
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Администратор создаётся при первом запуске, если его ещё нет.
# Логин: латинские буквы, цифры, _. Пароль: от 8 символов, буква и цифра
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# true — при пустой таблице студентов загрузить 25 демо-студентов
DEMO_DATA=true
