{
  "info": {
    "name": "web_lab_3 — студенты общежития (Jakarta EE)",
    "description": "Коллекция для лабораторной работы №3. Запускайте папки по порядку: 1) Авторизация сохраняет токены в переменные коллекции, остальные папки их используют. Перед запуском поднимите БД и сервер (см. README.md). Логин и пароль администратора — переменные adminUsername и adminPassword (как в .env).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "1. Авторизация",
      "description": "Регистрация, вход, обновление токенов.",
      "item": [
        {
          "name": "Регистрация пользователя",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "{",
                  "    pm.test(\"Роль USER\", function () { pm.expect(pm.response.json().role).to.eql(\"USER\"); });",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"username\", \"user_\" + Date.now());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Новый пользователь всегда получает роль USER. Логин генерируется заново при каждом запуске.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"password\": \"user12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Регистрация: логин занят",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "{",
                  "    pm.test(\"Ошибка в едином формате\", function () {",
                  "        const error = pm.response.json().error;",
                  "        pm.expect(error).to.have.keys(\"status\", \"code\", \"message\", \"details\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Тот же логин второй раз — 409 CONFLICT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"other_{{username}}@example.com\",\n  \"password\": \"user12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Регистрация: неверные данные",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "{",
                  "    pm.test(\"Ошибка в едином формате\", function () {",
                  "        const error = pm.response.json().error;",
                  "        pm.expect(error).to.have.keys(\"status\", \"code\", \"message\", \"details\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Короткий логин, неверная почта, слабый пароль — 422 со списком полей.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"a\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Вход ADMIN",
